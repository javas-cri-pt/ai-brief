# Gateway LLM compatibile OpenAI
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# "auto:free" = scoperta dinamica dei modelli free su OpenRouter; oppure elenco separato da virgole
LLM_MODELS=auto:free
# Generazione del replay con modello self-hosted (nessun limite di richieste), solo in locale:
REPLAY_LLM_BASE_URL=
REPLAY_LLM_API_KEY=
REPLAY_LLM_MODELS=

# Codici di accesso alla modalità live, con tetto giornaliero di chiamate LLM per codice
ACCESS_CODES=redazione:30,ospiti:36
GLOBAL_DAILY_CAP=150

# Storage persistente su Vercel (integrazione Upstash Redis). Se assente: SQLite (in /tmp su Vercel, non persistente)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Marchio (white-label)
BRAND_NAME=AI Brief
PUBLISHER_NAME=Editore Demo
PUBLISHER_DESC=Editore Demo, centro di ricerca sull'innovazione digitale
PUBLISHER_SECTION=Dall'editore
